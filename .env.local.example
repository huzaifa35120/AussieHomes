# Supabase Configuration
# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin credentials (set these as Supabase Auth users)
# Create an admin user in Supabase Auth > Users after setup

# Optional: Email notifications for contact form
# SMTP settings if you want email alerts for new enquiries
CONTACT_EMAIL=auzihomes@gmail.com

# ---- Enquiry email notifications (Resend) ----
# 1. Sign up free at https://resend.com
# 2. API Keys -> Create API Key -> paste it below
# 3. Until you verify auzihomes.com.au as a domain in Resend, leave RESEND_FROM
#    as the shared onboarding sender. Note: that test sender can ONLY deliver to
#    the email address you signed up to Resend with.
RESEND_API_KEY=
RESEND_FROM=Auzi Homes Website <onboarding@resend.dev>
