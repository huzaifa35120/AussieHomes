# Supabase Configuration
# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin credentials (set these as Supabase Auth users)
# Create an admin user in Supabase Auth > Users after setup

# Optional: Email notifications for contact form
# SMTP settings if you want email alerts for new enquiries
CONTACT_EMAIL=info@auzihomes.com.au
